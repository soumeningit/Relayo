# Prisma CLI / seed config — copy this file to `.env`.
# Should match the backend DATABASE_URL; used by `prisma migrate` and `db:seed:*`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# TLS certificate verification for the runtime driver (pg via @prisma/adapter-pg).
#   Preferred — verify the server cert against a CA bundle. Paste the full PEM
#   (Aiven: Services → your Postgres → CA Certificate) on a single line:
# PG_SSL_CA_CERT=-----BEGIN CERTIFICATE-----…-----END CERTIFICATE-----

#   Fallback for hosts with self-signed certs — encrypt WITHOUT verification:
# PG_SSL_NO_VERIFY=1
# (If both are set, PG_SSL_CA_CERT wins with a warning.)