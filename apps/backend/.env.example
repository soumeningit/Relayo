# Relayo backend — copy this file to `.env` and fill in real values.
# NEVER commit `.env`; it contains live secrets.

# ---- App ----
APP_NAME=Relayo
PORT=5000

# ---- Postgres ----
# Local:                  postgresql://postgres:postgres@localhost:5432/relayo
# Supabase:               postgresql://USER:PASSWORD@HOST:5432/POSTGRES?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ---- Auth / encryption ----
# JWT signing secret (any long random string).
JWT_SECRET=replace-with-a-long-random-string
# AES-256-GCM key used to encrypt destination signing secrets at rest.
# MUST be exactly 32 bytes (64 hex characters). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-a-64-character-hex-string

# ---- Frontend URLs ----
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---- SMTP (verification / password reset / invites) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM="Relayo Support" <you@example.com>

# ---- Cloudinary (avatar uploads) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- Redis (rate limiter + BullMQ queue + destination-secret cache) ----
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=            # set when Redis requires auth (Upstash, etc.)
# REDIS_TLS=true             # set for Upstash — TLS-only endpoints (incoming deploys)

# ---- Razorpay payments (one-time 30-day plan periods, no subscriptions) ----
# Key ID is public (sent to the browser checkout modal); Secret stays server-side.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook secret, from Razorpay Dashboard → Settings → Webhooks. Required only
# for the reconciliation webhook at POST /webhooks/razorpay.
# RAZORPAY_WEBHOOK_SECRET=your_dashboard_webhook_secret

# ---- Optional tuning ----
# RATE_LIMIT_ENABLED=false   # run the API WITHOUT rate limiting (baseline load tests)
# DB_POOL_MAX=20             # Prisma connection pool size
# DB_CONNECTION_TIMEOUT_MS=5000
# DELIVERY_WORKER_CONCURRENCY=5
# RUN_WORKERS=true           # boot delivery + rate-limiter workers inside the API process (single-service deploys)