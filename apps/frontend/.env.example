# Relayo frontend — copy this file to `.env` and fill in real values.
# Vite inlines VITE_* vars at build time and ships them to the browser:
# never put real secrets here.

# Base URL of the backend API (local dev or your deployed URL).
VITE_BACKEND_BASE_URL=http://localhost:5000

# (Optional) Client-side key used to encrypt data at rest in localStorage
# (a safe fallback is already built in). Any value a visitor can read — it
# only discourages casual local inspection; do not rely on it for real secrets.
# VITE_ENCRYPT_STORAGE_KEY=replace-with-any-random-string